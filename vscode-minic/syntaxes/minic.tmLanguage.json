{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "MiniC",
  "scopeName": "source.minic",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#functions" },
    { "include": "#properties" },
    { "include": "#arrays" },
    { "include": "#types" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.minic", "match": "//.*$" },
        { "name": "comment.block.minic", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "strings": {
      "name": "string.quoted.double.minic",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.minic", "match": "\\\\[ntr\"\\\\]" },
        { "name": "invalid.illegal.escape.minic", "match": "\\\\." }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.float.minic", "match": "\\b\\d+\\.\\d+\\b" },
        { "name": "constant.numeric.integer.minic", "match": "\\b\\d+\\b" }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "storage.type.minic", "match": "\\b(int|float|bool|string|void|class)\\b" },
        { "name": "storage.modifier.minic", "match": "\\b(public|private|const)\\b" },
        { "name": "keyword.control.minic", "match": "\\b(if|else|while|for|break|continue|return|new)\\b" },
        { "name": "variable.language.this.minic", "match": "\\bthis\\b" },
        { "name": "constant.language.boolean.minic", "match": "\\b(true|false|null)\\b" },
        { "name": "support.function.builtin.minic", "match": "\\b(print|read)\\b" }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": { "1": { "name": "entity.name.function.minic" } }
        }
      ]
    },
    "properties": {
      "patterns": [
        {
          "match": "(?<=\\.)\\b([a-zA-Z_][a-zA-Z0-9_]*)\\b(?!\\s*\\()",
          "captures": { "1": { "name": "support.variable.property.minic" } }
        }
      ]
    },
    "arrays": {
      "patterns": [
        {
          "match": "\\b([a-z_][a-zA-Z0-9_]*)\\s*(?=\\[)",
          "captures": { "1": { "name": "support.variable.minic" } }
        },
        {
          "name": "punctuation.section.brackets.minic",
          "match": "\\[|\\]"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "match": "\\b([A-Z][a-zA-Z0-9_]*)\\b",
          "captures": { "1": { "name": "entity.name.type.class.minic" } }
        }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.comparison.minic", "match": "==|!=|<=|>=|<|>" },
        { "name": "keyword.operator.logical.minic", "match": "&&|\\|\\||!" },
        { "name": "keyword.operator.assignment.minic", "match": "=" },
        { "name": "keyword.operator.arithmetic.minic", "match": "\\+|-|\\*|/|%" }
      ]
    }
  }
}
